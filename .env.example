# Copy to .env (gitignored) and change every value.
WH_USER=foodprices
WH_PASSWORD=change_me
WH_DB=foodprices

# Linux: run `id -u` and use that value (avoids root-owned files in ./data and ./logs)
AIRFLOW_UID=50000
AIRFLOW_SECRET_KEY=change_me_to_a_long_random_string
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

GRAFANA_ADMIN_PASSWORD=change_me

# Optional: set to 100 if profiling shows inflation_* columns are fractions (0.12 = 12%)
INFLATION_SCALE=1
